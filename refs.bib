@inproceedings{didelez2006_stoch_mech_intv,
author = {Didelez, Vanessa and Dawid, A. Philip and Geneletti, Sara},
title = {Direct and indirect effects of sequential treatments},
year = {2006},
isbn = {0974903922},
publisher = {AUAI Press},
